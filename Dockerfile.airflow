# Extended Apache Airflow image with dbt, LightGBM, and MLflow pipeline dependencies
# Multi-arch support: linux/amd64 & linux/arm64
FROM apache/airflow:3.3.2

USER root

# Install libgomp1 (required for LightGBM & XGBoost OpenMP execution)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install project pipeline requirements inside Airflow environment
RUN pip install --no-cache-dir \
    "dbt-postgres>=1.11.0,<1.12.0" \
    "psycopg[binary]>=3.3.6" \
    "lightgbm>=4.7.0" \
    "xgboost>=3.4.1" \
    "pandas>=3.0.0" \
    "onnx>=1.23.2" \
    "onnxmltools>=1.16.0" \
    "onnxruntime>=1.31.0" \
    "pyarrow>=25.0.1" \
    "pyyaml>=6.0.3" \
    "skl2onnx>=1.20.0" \
    "scikit-learn>=1.9.1" \
    "mlflow>=3.17.0" \
    "joblib>=1.6.0"
